<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
	<!-- The guide tab and its content are plain frames built with CreateFrame in Panel.lua. -->
	<!-- They reuse the stock QuestLogTabButtonTemplate directly (see Panel.lua Attach()) instead of a home-grown template here, and anchor to QuestMapFrame in Lua once Blizzard_WorldMap loads. -->
	<!-- The route pin below must be a real XML template: MapCanvasMixin AcquirePin resolves its template argument through CreateFramePool, which needs a declared virtual frame. -->
	<Frame name="AdventureGuideForeverPinTemplate" mixin="AdventureGuideForeverPinMixin" enableMouse="true" virtual="true">
		<Size x="26" y="26"/>
		<Layers>
			<!-- The panel's numbered ring, so a map pin reads as the same step as its route row. A dark disc, cut round
			     with the stock portrait mask, keeps the number legible over bright map art. -->
			<Layer level="BACKGROUND">
				<Texture parentKey="Disc">
					<Size x="22" y="22"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
					<Color r="0" g="0" b="0" a="0.75"/>
				</Texture>
				<MaskTexture parentKey="DiscMask" file="Interface\CharacterFrame\TempPortraitAlphaMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Disc"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Disc"/>
					</Anchors>
					<MaskedTextures>
						<MaskedTexture childKey="Disc"/>
					</MaskedTextures>
				</MaskTexture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon" atlas="adventureguide-ring" setAllPoints="true"/>
			</Layer>
			<Layer level="OVERLAY">
				<!-- Blizzard's bevelled gold numerals, each drawn centred in its own atlas box, so the digit sits exactly in
				     the ring whatever its width. Sized so the digit is about 11px tall. -->
				<Texture parentKey="Number">
					<Size x="22" y="25"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<!-- The quest POI's own hover glow, over the ring; shown from OnMouseEnter since a Frame has no highlight state. -->
			<Layer level="ARTWORK" textureSubLevel="1">
				<Texture parentKey="Glow" atlas="UI-QuestPoi-InnerGlow" alphaMode="ADD" hidden="true">
					<Size x="30" y="30"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<!-- No OnEnter/OnLeave scripts: MapCanvas asserts a new pin has none and wires OnMouseEnter/OnMouseLeave itself. -->
		<!-- OnClick is not an XML script here: MapCanvasMixin OnPinMouseUp calls pin OnClick(button) directly once IsMouseClickEnabled() is true (see enableMouse above), same as OnMouseUp/Down. -->
	</Frame>
</Ui>
