{
  "runtime.version": "Lua 5.1",
  "workspace.library": [
    ".types/vscode-wow-api/Annotations/Core",
    ".types/vscode-wow-api/Annotations/FrameXML",
    "types"
  ],
  "workspace.ignoreDir": [
    ".types",
    "tests",
    "tools",
    ".sift",
    ".release",
    ".claude"
  ],
  "workspace.checkThirdParty": false,
  "workspace.maxPreload": 10000,
  "workspace.preloadFileSize": 2000,
  "diagnostics.libraryFiles": "Disable",
  "diagnostics.neededFileStatus": {
    "param-type-mismatch": "Any",
    "redundant-parameter": "Any",
    "missing-parameter": "Any",
    "undefined-field": "Any",
    "undefined-global": "Any",
    "need-check-nil": "Any",
    "assign-type-mismatch": "Any",
    "return-type-mismatch": "Any",
    "cast-local-type": "Any",
    "redundant-return-value": "Any",
    "missing-return": "Any",
    "unused-local": "Any"
  },
  "diagnostics.severity": {
    "param-type-mismatch": "Error",
    "redundant-parameter": "Error",
    "missing-parameter": "Error",
    "undefined-field": "Error",
    "undefined-global": "Error",
    "need-check-nil": "Error",
    "assign-type-mismatch": "Error",
    "return-type-mismatch": "Error",
    "cast-local-type": "Error",
    "redundant-return-value": "Error",
    "missing-return": "Error",
    "unused-local": "Error"
  },
  "diagnostics.groupSeverity": {
    "unused": "Information",
    "redefined": "Information"
  },
  "diagnostics.groupFileStatus": {
    "type-check": "Any",
    "unused": "Any",
    "redefined": "Any",
    "duplicate": "Any"
  },
  "type.checkTableShape": true,
  "type.weakUnionCheck": false,
  "type.weakNilCheck": false
}
