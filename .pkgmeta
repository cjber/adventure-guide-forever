package-as: AdventureGuideForever

manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

# The packager already drops every dot-prefixed path, so only the rest is listed.
ignore:
  - .agents
  - .sloppatrol
  - AGENTS.md
  - tools
  - types
  - tests
  - docs
  - Locales/phrases.txt
  - Locales/README.md
  - media/icon.svg
  - media/icon-400.png
  - stylua.toml
  - ruff.toml
  - .claude
  - forever-core

# CurseForge relations: the CurseForge slug of every OptionalDeps folder in the root .toc (WFA-28).
optional-dependencies:
  - atlasloot-forever
  - shortest-path-forever
  - questie
  - questiedb
  - skillup-forever
  - legacy-forever
  - tweaks-forever
  - restedxp-guide
  - polestar

# ForeverCore ships inside this zip as its own folder, from the release tools/forever-core.txt pins, because
# its CurseForge project is not yet approved and so cannot be a required-dependencies relation.
externals:
  ForeverCore: https://github.com/cjber/forever-core/releases/download/v1.1.0/ForeverCore-v1.1.0-forever.zip

move-folders:
  AdventureGuideForever/ForeverCore: ForeverCore
